# Copy this file to backend/.env and fill in the values you have.
# The app starts in demo mode with no credentials.

DEMO_MODE=true

# Google OAuth (required only when DEMO_MODE=false)
# Create a Web application client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Free model. Groq has a free tier and uses the OpenAI API shape.
# 1. Create a free key at https://console.groq.com/keys
# 2. Paste it below
# 3. Set DEMO_MODE=false and restart the backend
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Other free option: a Google AI Studio key from https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Paid OpenAI, only if you choose it
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional background polling. The app works with this turned off.
EMAIL_POLL_ENABLED=false
EMAIL_POLL_INTERVAL=60

# How many recent Gmail messages to pull on each sync.
GMAIL_SYNC_LIMIT=25

FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Leave blank to use backend/data/email_assistant.db
DATABASE_URL=
