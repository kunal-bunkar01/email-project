# Copy this file to backend/.env and fill in the values you have.
# The app starts in demo mode with no credentials.

DEMO_MODE=true

# Google OAuth (required only when DEMO_MODE=false)
# Create a Web application client in Google Cloud Console.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OpenAI (required only when DEMO_MODE=false and you want live replies)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional background polling. The app works with this turned off.
EMAIL_POLL_ENABLED=false
EMAIL_POLL_INTERVAL=60

# How many recent Gmail messages to pull on each sync.
GMAIL_SYNC_LIMIT=25

FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Leave blank to use backend/data/email_assistant.db
DATABASE_URL=
